@using AfroEvent.ViewModels
@{
    ViewData["Title"] = "Accueil";
    var events  = ViewBag.EventList as IEnumerable<EventFormViewModel> ?? Enumerable.Empty<EventFormViewModel>();
    var isOrg   = User.IsInRole("Organisateur");
    var isAuth  = User.Identity?.IsAuthenticated == true;
}

<!-- ══ HERO ═══════════════════════════════════════════════════ -->
<div class="position-relative rounded-4 overflow-hidden mb-5 shadow-lg"
     style="background:linear-gradient(140deg,#111622 0%,#1A2236 55%,#2C1508 100%);min-height:480px;">

    <!-- Orbes décoratifs -->
    <div class="position-absolute"
         style="width:600px;height:600px;background:radial-gradient(circle,rgba(255,183,3,0.12) 0%,transparent 65%);
                top:-150px;right:-100px;pointer-events:none;"></div>
    <div class="position-absolute"
         style="width:400px;height:400px;background:radial-gradient(circle,rgba(243,112,33,0.10) 0%,transparent 65%);
                bottom:-100px;left:-80px;pointer-events:none;"></div>

    <div class="position-relative d-flex flex-column align-items-center justify-content-center
                text-center py-5 px-3" style="min-height:480px;z-index:1;">

        <span class="badge mb-4 px-3 py-2"
              style="background:rgba(255,183,3,0.15);color:#FFB703;
                     border:1px solid rgba(255,183,3,0.3);
                     font-size:0.72rem;font-weight:700;letter-spacing:0.1em;border-radius:999px;">
            🌍 PLATEFORME ÉVÉNEMENTIELLE
        </span>

        <h1 class="fw-bold text-white mb-3"
            style="font-size:clamp(1.75rem,4.5vw,3rem);line-height:1.12;max-width:700px;">
            Organisez. Vendez. <span class="gradient-text">Remplissez</span> vos événements.
        </h1>

        <p class="text-white-50 mb-5"
           style="max-width:520px;font-size:1.05rem;">
            De l'inscription à la billetterie, AfroEvent prend en charge l'intégralité
            de la gestion de vos événements — simplement, rapidement, sans friction.
        </p>

        <div class="d-flex flex-wrap gap-3 justify-content-center">
            <a asp-controller="Events" asp-action="Index"
               class="btn btn-afro-gold btn-lg px-4 py-3 rounded-3 fw-bold shadow-sm">
                <i class="bi bi-calendar-event-fill me-2"></i>Voir les événements
            </a>
            @if (isOrg)
            {
                <a asp-controller="Events" asp-action="Create"
                   class="btn btn-outline-light btn-lg px-4 py-3 rounded-3 fw-semibold">
                    <i class="bi bi-plus-circle me-2"></i>Créer un événement
                </a>
            }
            else if (!isAuth)
            {
                <a asp-area="Identity" asp-page="/Account/Register"
                   class="btn btn-outline-light btn-lg px-4 py-3 rounded-3 fw-semibold">
                    <i class="bi bi-person-plus me-2"></i>Créer un compte
                </a>
            }
        </div>
    </div>
</div>

<!-- ══ CHIFFRES ════════════════════════════════════════════════ -->
<div class="row g-4 mb-5 text-center">
    @{
        var stats = new[]
        {
            new { Value="100%", Label="Dématérialisé",      Sub="Aucun papier, tout sur mobile" },
            new { Value="0",    Label="Perte de données",   Sub="Billets sécurisés et traçables" },
            new { Value="∞",    Label="Capacité de gestion",Sub="Autant d'événements que vous voulez" },
        };
    }
    @foreach (var s in stats)
    {
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 py-4 px-3 hover-lift h-100">
                <div class="fw-black mb-1" style="font-size:2.5rem;color:#F37021;line-height:1;">@s.Value</div>
                <div class="fw-bold text-dark mb-1">@s.Label</div>
                <div class="small text-muted">@s.Sub</div>
            </div>
        </div>
    }
</div>

<!-- ══ ÉVÉNEMENTS À VENIR ══════════════════════════════════════ -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="font-size:1.45rem;">Événements à venir</h2>
        <p class="text-muted mb-0 small">Réservez votre place avant qu'il ne soit trop tard.</p>
    </div>
    <a asp-controller="Events" asp-action="Index"
       class="btn btn-sm btn-outline-secondary fw-semibold rounded-3 px-3">
        Tout voir <i class="bi bi-arrow-right ms-1"></i>
    </a>
</div>

@if (events.Any())
{
    <div class="row g-4 mb-5">
        @foreach (var evt in events.Take(3))
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card event-card border-0 shadow-sm h-100">
                    <div class="position-relative">
                        <img src="@(string.IsNullOrEmpty(evt.CoverImageUrl)
                                        ? "https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=600&q=80"
                                        : evt.CoverImageUrl)"
                             class="event-img" alt="@evt.Title" loading="lazy" />
                        <span class="position-absolute top-0 end-0 m-3 badge-category">
                            @evt.CategoryName
                        </span>
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="small text-muted mb-2">
                            <i class="bi bi-calendar-event text-warning me-1"></i>
                            @evt.StartDate.ToString("dd MMMM yyyy · HH:mm")
                        </div>
                        <h5 class="fw-bold text-dark mb-2 text-truncate-2">@evt.Title</h5>
                        <div class="small text-muted mb-3">
                            <i class="bi bi-geo-alt text-danger me-1"></i>@evt.LocationAddress
                        </div>
                        <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                            @if (evt.Price > 0)
                            {
                                <span class="fw-bold">@evt.Price.ToString("N0")
                                    <small class="text-muted fw-normal">FCFA</small>
                                </span>
                            }
                            else
                            {
                                <span class="badge-success-soft px-3 py-1">Gratuit</span>
                            }
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@evt.Id"
                               class="btn btn-sm btn-afro px-3 rounded-3">
                                Voir <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mb-5">
        <a asp-controller="Events" asp-action="Index"
           class="btn btn-outline-secondary fw-semibold rounded-3 px-4 py-2">
            <i class="bi bi-grid-3x3-gap me-2"></i>Voir tous les événements
        </a>
    </div>
}
else
{
    <div class="text-center py-5 mb-5">
        <i class="bi bi-calendar2-x" style="font-size:4rem;color:#CBD5E1;"></i>
        <h5 class="text-muted fw-semibold mt-3 mb-2">Aucun événement pour le moment</h5>
        <p class="text-muted small mb-4">Les prochains événements apparaîtront ici dès leur publication.</p>
        @if (isOrg)
        {
            <a asp-controller="Events" asp-action="Create" class="btn btn-afro px-4 py-2 rounded-3">
                <i class="bi bi-plus-circle me-2"></i>Publier le premier événement
            </a>
        }
    </div>
}

<!-- ══ POUR QUI ? ═══════════════════════════════════════════════ -->
<div class="rounded-4 mb-5 overflow-hidden"
     style="background:linear-gradient(140deg,#0F121D,#1A2236);">
    <div class="p-4 p-md-5">
        <div class="text-center mb-5">
            <h3 class="fw-bold text-white mb-2">Pensé pour chaque acteur de l'événement</h3>
            <p class="text-white-50 mx-auto mb-0" style="max-width:480px;">
                Que vous organisiez, participiez ou supervisiez — AfroEvent s'adapte à votre rôle.
            </p>
        </div>
        <div class="row g-4 justify-content-center">
            @{
                var profiles = new[]
                {
                    new { Icon="bi-briefcase-fill", Color="#FFB703",
                          Title="Vous organisez",
                          Desc="Créez votre événement, gérez les inscriptions et suivez vos ventes en un seul endroit. Fini les tableurs et les groupes WhatsApp.",
                          Cta="Devenir organisateur",
                          Url="/Identity/Account/Register" },
                    new { Icon="bi-ticket-detailed-fill", Color="#0DCAF0",
                          Title="Vous participez",
                          Desc="Trouvez les événements qui vous correspondent, réservez votre place et recevez votre billet instantanément.",
                          Cta="Explorer les événements",
                          Url="/Events" },
                };
            }
            @foreach (var p in profiles)
            {
                <div class="col-12 col-md-6" style="max-width:440px;">
                    <div class="glass-card p-4 h-100">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:52px;height:52px;background:rgba(255,255,255,0.06);">
                                <i class="bi @p.Icon fs-3" style="color:@p.Color;"></i>
                            </div>
                            <h5 class="fw-bold mb-0" style="color:@p.Color;">@p.Title</h5>
                        </div>
                        <p class="text-white-50 small mb-4">@p.Desc</p>
                        <a href="@p.Url" class="btn btn-outline-light rounded-pill fw-semibold px-4 py-2 w-100">
                            @p.Cta <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>