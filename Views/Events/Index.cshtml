@model IEnumerable<AfroEvent.ViewModels.EventFormViewModel>
@{
    ViewData["Title"] = "Catalogue des Événements";
    var isOrg   = User.IsInRole("Organisateur");
    var canCreate = isOrg;
}

<!-- En-tête page -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h1 class="fw-bold mb-1" style="font-size:1.65rem;">
            <i class="bi bi-calendar-event text-warning me-2"></i>Catalogue des Événements
        </h1>
        <p class="text-muted mb-0 small">Hackathons, conférences, concerts, bootcamps — réservez en quelques clics.</p>
    </div>
    @if (canCreate)
    {
        <a asp-controller="Events" asp-action="Create"
           class="btn btn-afro-gold fw-bold px-4 py-2 rounded-3 shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Créer un événement
        </a>
    }
</div>

<!-- ══ FILTRES ══════════════════════════════════════════════════ -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="searchInput"
                           class="form-control bg-light border-start-0"
                           placeholder="Rechercher un événement, ville ou lieu..." />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select id="categoryFilter" class="form-select bg-light">
                    <option value="">Toutes les catégories</option>
                    <option value="Hackathon">Hackathon</option>
                    <option value="Bootcamp">Bootcamp</option>
                    <option value="Conférence">Conférence</option>
                    <option value="Workshop">Workshop</option>
                    <option value="Concert">Concert</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select id="priceFilter" class="form-select bg-light">
                    <option value="">Tous les prix</option>
                    <option value="free">Gratuit</option>
                    <option value="paid">Payant</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- ══ GRILLE DES ÉVÉNEMENTS ══════════════════════════════════ -->
@if (Model != null && Model.Any())
{
    <div id="eventsGrid" class="row g-4 mb-5">
        @foreach (var evt in Model)
        {
            <div class="col-12 col-md-6 col-lg-4 event-item"
                 data-title="@evt.Title.ToLower()"
                 data-location="@evt.LocationAddress.ToLower()"
                 data-category="@evt.CategoryName"
                 data-price="@(evt.Price > 0 ? "paid" : "free")">
                <div class="card event-card border-0 shadow-sm h-100">
                    <div class="position-relative">
                        <img src="@(string.IsNullOrEmpty(evt.CoverImageUrl)
                                        ? "https://images.unsplash.com/photo-1515187029135-18ee286d815b?auto=format&fit=crop&w=600&q=80"
                                        : evt.CoverImageUrl)"
                             class="event-img" alt="@evt.Title" loading="lazy" />
                        <span class="position-absolute top-0 end-0 m-3 badge-category">
                            @evt.CategoryName
                        </span>
                        @if (evt.Price == 0)
                        {
                            <span class="position-absolute bottom-0 start-0 m-3 badge-success-soft px-3 py-1">
                                Gratuit
                            </span>
                        }
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="small text-muted mb-2">
                            <i class="bi bi-calendar-event text-warning me-1"></i>
                            @evt.StartDate.ToString("dd MMMM yyyy · HH:mm")
                        </div>
                        <h5 class="fw-bold text-dark mb-2 text-truncate-2">@evt.Title</h5>
                        <p class="text-muted small mb-3 text-truncate-2">@evt.Description</p>
                        <div class="small text-muted mb-3">
                            <i class="bi bi-geo-alt text-danger me-1"></i>@evt.LocationAddress
                        </div>
                        <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                            <div>
                                @if (evt.Price > 0)
                                {
                                    <span class="fw-bold fs-5">@evt.Price.ToString("N0") <small class="text-muted fw-normal fs-6">FCFA</small></span>
                                }
                                else
                                {
                                    <span class="badge-success-soft px-3 py-1 fw-semibold">Gratuit</span>
                                }
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                @if (canCreate)
                                {
                                    <a asp-controller="Events" asp-action="Edit" asp-route-id="@evt.Id"
                                       class="btn btn-sm btn-outline-secondary rounded-3"
                                       title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@evt.Id"
                                   class="btn btn-sm btn-afro px-3 rounded-3">
                                    Voir <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Message "aucun résultat" pour les filtres -->
    <div id="noResults" class="text-center py-5 d-none">
        <i class="bi bi-search" style="font-size:3rem;color:#CBD5E1;"></i>
        <p class="text-muted mt-3 fw-semibold">Aucun événement ne correspond à votre recherche.</p>
        <button onclick="resetFilters()" class="btn btn-sm btn-outline-secondary rounded-3 mt-2">
            <i class="bi bi-x-circle me-1"></i>Réinitialiser les filtres
        </button>
    </div>
}
else
{
    <div class="text-center py-5 mb-5">
        <i class="bi bi-calendar2-x" style="font-size:5rem;color:#CBD5E1;"></i>
        <h4 class="text-muted fw-semibold mt-4 mb-2">Aucun événement disponible</h4>
        <p class="text-muted mb-4">Soyez le premier à créer un événement sur la plateforme AfroEvent !</p>
        @if (canCreate)
        {
            <a asp-controller="Events" asp-action="Create"
               class="btn btn-afro btn-lg px-5 py-3 rounded-3 shadow-sm">
                <i class="bi bi-plus-circle-fill me-2"></i>Créer le premier événement
            </a>
        }
    </div>
}

@section Scripts {
<script>
    const searchInput    = document.getElementById('searchInput');
    const categoryFilter = document.getElementById('categoryFilter');
    const priceFilter    = document.getElementById('priceFilter');
    const items          = document.querySelectorAll('.event-item');
    const noResults      = document.getElementById('noResults');

    function applyFilters() {
        const search   = searchInput?.value.toLowerCase().trim() || '';
        const category = categoryFilter?.value || '';
        const price    = priceFilter?.value || '';
        let visible    = 0;

        items.forEach(item => {
            const title    = item.dataset.title    || '';
            const location = item.dataset.location || '';
            const cat      = item.dataset.category || '';
            const pr       = item.dataset.price    || '';

            const matchSearch   = !search   || title.includes(search) || location.includes(search);
            const matchCategory = !category || cat === category;
            const matchPrice    = !price    || pr === price;

            const show = matchSearch && matchCategory && matchPrice;
            item.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        if (noResults) {
            noResults.classList.toggle('d-none', visible > 0);
        }
    }

    function resetFilters() {
        if (searchInput)    searchInput.value    = '';
        if (categoryFilter) categoryFilter.value = '';
        if (priceFilter)    priceFilter.value    = '';
        applyFilters();
    }

    searchInput?.addEventListener('input', applyFilters);
    categoryFilter?.addEventListener('change', applyFilters);
    priceFilter?.addEventListener('change', applyFilters);
</script>
}
