@using Microsoft.AspNetCore.Identity
@using AfroEvent.Models

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="d-flex align-items-center gap-2">
        <a id="manage" class="text-light text-decoration-none fw-semibold" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
            <i class="bi bi-person-circle text-warning me-1"></i> @(UserManager.GetUserName(User)?.Split('@')[0])
        </a>
        <form id="logoutForm" class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="btn btn-sm btn-outline-danger fw-semibold px-3 rounded-pill">
                <i class="bi bi-box-arrow-right me-1"></i>Quitter
            </button>
        </form>
    </div>
}
else
{
    <a class="text-light text-decoration-none fw-semibold px-2 hover-warning" id="register" asp-area="Identity" asp-page="/Account/Register">
        S'inscrire
    </a>
    <a class="btn btn-warning text-dark fw-bold px-4 py-2 rounded-pill shadow-sm" id="login" asp-area="Identity" asp-page="/Account/Login">
        <i class="bi bi-box-arrow-in-right me-1"></i>Connexion
    </a>
}
