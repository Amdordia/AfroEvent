@using Microsoft.AspNetCore.Http
@{
    var layoutNotif = Context.Session.GetString("PaymentNotification");
    if (!string.IsNullOrEmpty(layoutNotif))
    {
        Context.Session.Remove("PaymentNotification");
    }
    var isAdmin = User.IsInRole("Admin");
    var isOrg   = User.IsInRole("Organisateur");
    var isAuth  = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AfroEvent</title>
    <meta name="description" content="AfroEvent — La plateforme centralisée d'organisation et de billetterie d'événements pour l'écosystème africain." />

    <!-- Google Fonts : Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

    <!-- Leaflet.js (OpenStreetMap) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- AfroEvent Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    @if (!string.IsNullOrEmpty(layoutNotif))
    {
        <span id="sessionNotificationHelper" data-message="@layoutNotif" style="display:none;"></span>
    }

    <!-- ══ NAVBAR ══════════════════════════════════════════════ -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-afro py-2">
            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2 text-decoration-none"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-ticket-perforated-fill text-warning fs-4"></i>
                    <span style="color:#fff; font-size:1.15rem;">
                        Afro<span style="color:#FFB703;">Event</span>
                    </span>
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">

                    <!-- Navigation principale -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Accueil
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">
                                <i class="bi bi-calendar-event me-1"></i>Événements
                            </a>
                        </li>

                        @* Onglet Participant : uniquement pour les utilisateurs authentifiés non-org non-admin *@
                        @if (isAuth && !isAdmin && !isOrg)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MesBillets">
                                    <i class="bi bi-ticket me-1"></i>Mes billets
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Actions à droite -->
                    <div class="d-flex align-items-center gap-2">

                        @* Cloche notifications (tous les authentifiés sauf admin qui a son panneau) *@
                        @if (isAuth)
                        {
                            <div class="position-relative">
                                <button class="btn btn-link text-light p-2 position-relative"
                                        id="notifToggle"
                                        onclick="toggleNotifications(event)"
                                        aria-label="Notifications">
                                    <i class="bi bi-bell-fill" style="font-size:1.1rem;color:#FFB703;"></i>
                                    <span id="notifBadge"
                                          class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                          style="display:none; font-size:0.6rem;">0</span>
                                </button>
                                <div id="notifDropdown"
                                     class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0"
                                     style="min-width:320px; display:none; border-radius:0.875rem; overflow:hidden;">
                                    <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center"
                                         style="background:#F8FAFC;">
                                        <span class="fw-bold small text-dark">
                                            <i class="bi bi-bell me-1 text-warning"></i>Notifications
                                        </span>
                                        <button class="btn btn-link btn-sm text-muted p-0" onclick="markAllAsRead()">
                                            Tout lire
                                        </button>
                                    </div>
                                    <div id="notifItems" style="max-height:280px; overflow-y:auto;">
                                        <div class="text-muted small text-center py-4">Aucune notification</div>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Dashboard Organisateur *@
                        @if (isOrg)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-warning btn-sm fw-semibold dropdown-toggle px-3"
                                        type="button" id="orgMenu"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-speedometer2 me-1"></i>Espace Org.
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3"
                                    style="min-width:220px;"
                                    aria-labelledby="orgMenu">
                                    <li>
                                        <a class="dropdown-item py-2"
                                           asp-controller="Organizer" asp-action="Dashboard">
                                            <i class="bi bi-grid-1x2-fill text-primary me-2"></i>Tableau de bord
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2"
                                           asp-controller="Organizer" asp-action="Events">
                                            <i class="bi bi-kanban-fill text-info me-2"></i>Mes événements
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-success fw-semibold"
                                           asp-controller="Events" asp-action="Create">
                                            <i class="bi bi-plus-circle-fill me-2"></i>Créer un événement
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }

                        @* Dashboard Admin *@
                        @if (isAdmin)
                        {
                            <a class="btn btn-warning btn-sm fw-bold px-3"
                               asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-shield-fill-check me-1"></i>Admin
                            </a>
                        }

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- ══ MESSAGES TEMPDATA ════════════════════════════════════ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 animate-fadein"
                 role="alert">
                <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-info alert-dismissible fade show d-flex align-items-center gap-2 animate-fadein"
                 role="alert">
                <i class="bi bi-info-circle-fill fs-5 flex-shrink-0"></i>
                <div>@TempData["InfoMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center gap-2 animate-fadein"
                 role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                <div>@TempData["WarningMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 animate-fadein"
                 role="alert">
                <i class="bi bi-x-circle-fill fs-5 flex-shrink-0"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        </div>
    }

    <!-- ══ CONTENU PRINCIPAL ════════════════════════════════════ -->
    <div class="container flex-grow-1 my-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- ══ FOOTER ═══════════════════════════════════════════════ -->
    <footer class="footer-afro py-4 mt-auto">
        <div class="container">
            <div class="row align-items-center gy-2">
                <div class="col-md-6">
                    <a asp-controller="Home" asp-action="Index"
                       class="text-decoration-none d-flex align-items-center gap-2">
                        <i class="bi bi-ticket-perforated-fill text-warning"></i>
                        <span class="fw-bold" style="color:#FFB703;">Afro<span style="color:rgba(255,255,255,0.7);">Event</span></span>
                    </a>
                    <p class="small mb-0 mt-1" style="color:rgba(255,255,255,0.4); max-width:400px;">
                        La solution centralisée d'organisation, de billetterie et d'analyse d'événements pour l'Afrique.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="small" style="color:rgba(255,255,255,0.3);">
                        &copy; @DateTime.Now.Year AfroEvent &nbsp;·&nbsp;
                        Conçu avec excellence par <strong style="color:rgba(255,255,255,0.5);">AfroEvent-TEAM</strong>
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <!-- QR Code Modal -->
    <div id="qrModal" onclick="if(event.target === this) closeQRModal();" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; justify-content:center; align-items:center; background:rgba(0,0,0,0.65); z-index:9999; backdrop-filter:blur(4px);">
      <div class="card border-0 shadow-lg text-center p-4" style="max-width:360px; width:90%; border-radius:1rem; background:#fff;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="fw-bold m-0 text-dark d-flex align-items-center gap-2">
            <i class="bi bi-qr-code-scan text-primary fs-5"></i> Pass / Notification QR
          </h6>
          <button type="button" class="btn-close" onclick="closeQRModal()" aria-label="Fermer"></button>
        </div>
        <div class="p-3 rounded-3 bg-light d-flex justify-content-center align-items-center mb-3 border">
          <canvas id="qrCanvas" style="max-width:100%; height:auto;"></canvas>
        </div>
        <p id="qrTextPreview" class="small text-muted mb-3 text-break" style="max-height:60px; overflow-y:auto; font-size:0.8rem;"></p>
        <button type="button" class="btn btn-secondary btn-sm rounded-pill fw-semibold w-100" onclick="closeQRModal()">
          Fermer
        </button>
      </div>
    </div>
    <!-- ══ SCRIPTS ══════════════════════════════════════════════ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"
            integrity="sha512-ybGm3Xc1w9/8VbT7xndjN4Wn9p11G2P5x3B4/z7kHqP/9Q=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.0/build/qrcode.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>