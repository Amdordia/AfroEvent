@{
    ViewData["Title"] = "Confirmation d'inscription — AfroEvent";
    var eventId      = ViewBag.EventId is Guid eid ? eid : Guid.Empty;
    var eventName    = (string)(ViewBag.EventName    ?? "Événement");
    var eventDate    = ViewBag.EventDate    is DateTime ed   ? ed   : (DateTime?)null;
    var eventLoc     = (string)(ViewBag.EventLocation ?? string.Empty);
    var eventPrice   = ViewBag.EventPrice   is decimal ep   ? ep   : 0m;
    var partName     = (string)(ViewBag.ParticipantName  ?? "Participant");
    var partEmail    = (string)(ViewBag.ParticipantEmail ?? string.Empty);
    var partPass     = (string)(ViewBag.ParticipantPass  ?? "Standard");
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-9 col-lg-6">

        <!-- Statut -->
        <div class="text-center mb-5">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4"
                 style="width:76px;height:76px;background:rgba(255,183,3,0.12);">
                <i class="bi bi-hourglass-split text-warning" style="font-size:2.2rem;"></i>
            </div>
            <h1 class="fw-bold mb-2" style="font-size:1.65rem;">Inscription enregistrée</h1>
            <p class="text-muted mb-0">
                Bonjour <strong class="text-dark">@partName</strong>, votre place est réservée.
                Finalisez le paiement pour recevoir votre e-billet.
            </p>
        </div>

        <!-- Récapitulatif -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-receipt text-warning me-2"></i>Récapitulatif de votre réservation
                </h6>

                <div class="d-flex flex-column gap-0">
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted small fw-semibold">Événement</span>
                        <span class="fw-bold text-dark text-end" style="max-width:65%;">@eventName</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted small fw-semibold">Participant</span>
                        <span class="fw-semibold text-dark">@partName</span>
                    </div>
                    @if (!string.IsNullOrEmpty(partEmail))
                    {
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted small fw-semibold">Email</span>
                            <span class="text-dark small">@partEmail</span>
                        </div>
                    }
                    @if (eventDate.HasValue)
                    {
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted small fw-semibold">Date</span>
                            <span class="fw-semibold text-dark small">@eventDate.Value.ToString("dd MMMM yyyy · HH:mm")</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(eventLoc))
                    {
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted small fw-semibold">Lieu</span>
                            <span class="fw-semibold text-dark small text-end" style="max-width:65%;">@eventLoc</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted small fw-semibold">Type de pass</span>
                        <span class="badge-category px-3 py-2">Pass @partPass</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted small fw-semibold">Montant</span>
                        <span class="fw-bold text-dark fs-5">
                            @if (eventPrice > 0)
                            {
                                @eventPrice.ToString("N0") <small class="text-muted fw-normal">FCFA</small>
                            }
                            else
                            {
                                <span class="text-success fw-bold">Gratuit</span>
                            }
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted small fw-semibold">Statut</span>
                        <span class="badge px-3 py-2 rounded-pill fw-semibold"
                              style="background:rgba(239,68,68,0.1);color:#EF4444;">
                            <i class="bi bi-clock me-1"></i>Paiement en attente
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bouton paiement (POST avec eventId) -->
        <form asp-controller="Participant" asp-action="Pay" method="post">
            @Html.AntiForgeryToken()
            <div class="d-grid gap-3">
                <button type="submit" class="btn btn-afro-gold btn-lg rounded-3 fw-bold py-3">
                    <i class="bi bi-credit-card-fill me-2"></i>
                    @if (eventPrice > 0)
                    {
                        <span>Payer @eventPrice.ToString("N0") FCFA et recevoir mon billet</span>
                    }
                    else
                    {
                        <span>Confirmer et recevoir mon billet gratuit</span>
                    }
                </button>
                <a asp-controller="Events" asp-action="Details" asp-route-id="@eventId"
                   class="btn btn-outline-secondary rounded-3 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i>Annuler et retourner à l'événement
                </a>
            </div>
        </form>

        <!-- Réassurance -->
        <div class="text-center mt-4">
            <small class="text-muted">
                <i class="bi bi-shield-check text-success me-1"></i>
                Paiement sécurisé · Billet envoyé instantanément
            </small>
        </div>

    </div>
</div>
