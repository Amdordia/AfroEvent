@{
    ViewData["Title"] = "Votre e-billet";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 2rem;">
                            ✓
                        </div>
                        <h1 class="fw-bold mt-3">Étape 3 : Votre e-billet</h1>
                        <p class="text-muted">Votre billet est prêt à être présenté à l’entrée.</p>
                        <div class="d-flex justify-content-center gap-2 mt-2">
                            <span class="badge bg-success">1. Inscription</span>
                            <span class="badge bg-success">2. Paiement</span>
                            <span class="badge bg-dark">3. Billet</span>
                        </div>
                    </div>

                    <div class="alert alert-success">
                        <strong>@ViewBag.SuccessMessage</strong>
                    </div>

                    <!-- Printable Ticket Container -->
                    <div id="pdf-ticket-container" class="p-4 bg-light border border-2 border-dashed rounded-4 mb-4">
                        <div class="text-center mb-3">
                            <h4 class="fw-bold text-warning">🌍 BILLET D'ENTRÉE - AfroEvent</h4>
                            <p class="text-muted small">Présentez ce QR Code à l'accueil de l'événement.</p>
                        </div>
                        <hr />
                        <div class="row g-4 align-items-center">
                            <div class="col-md-7">
                                <div class="p-2">
                                    <h5 class="fw-bold text-dark mb-3">Détails du participant</h5>
                                    <ul class="list-unstyled mb-0">
                                        <li class="mb-2"><strong>Événement :</strong> @ViewBag.EventName</li>
                                        <li class="mb-2"><strong>Participant :</strong> @ViewBag.ParticipantName</li>
                                        <li class="mb-2"><strong>Email :</strong> @ViewBag.ParticipantEmail</li>
                                        <li class="mb-2"><strong>Pass :</strong> <span class="badge bg-warning text-dark">@ViewBag.ParticipantPass</span></li>
                                        <li class="mb-2"><strong>Statut :</strong> <span class="badge bg-success">@ViewBag.PaymentStatus</span></li>
                                        <li class="mb-2"><strong>Numéro de billet :</strong> <code class="text-dark fw-bold">@ViewBag.TicketId</code></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-5 text-center">
                                <div class="p-2 d-flex flex-column align-items-center justify-content-center">
                                    <h6 class="fw-bold mb-2">QR Code de Validation</h6>
                                    <div id="qrcode" class="bg-white p-2 border rounded shadow-sm d-inline-block"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 text-center d-flex justify-content-center gap-2 flex-wrap">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">Retour à l'accueil</a>
                        <button onclick="downloadPDF()" class="btn btn-warning text-dark fw-bold">
                            <i class="bi bi-file-earmark-pdf-fill"></i> Télécharger le billet (PDF)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var qrcodeContainer = document.getElementById("qrcode");
            if (qrcodeContainer) {
                new QRCode(qrcodeContainer, {
                    text: "@ViewBag.TicketId",
                    width: 140,
                    height: 140,
                    colorDark : "#000000",
                    colorLight : "#ffffff",
                    correctLevel : QRCode.CorrectLevel.H
                });
            }
        });

        function downloadPDF() {
            const element = document.getElementById('pdf-ticket-container');
            
            // Configuration options for html2pdf
            const opt = {
                margin:       0.5,
                filename:     'Billet-@ViewBag.TicketId-.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { 
                    scale: 2, 
                    useCORS: true,
                    scrollX: 0,
                    scrollY: 0
                },
                jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
            };
            
            // Generate PDF from the ticket container
            html2pdf().set(opt).from(element).save();
        }
    </script>
}
