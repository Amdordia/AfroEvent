@{
    ViewData["Title"] = "Votre E-Billet — AfroEvent";
    var eventName    = (string)(ViewBag.EventName ?? "Événement");
    var participantName = (string)(ViewBag.ParticipantName ?? "Participant");
    var email        = (string)(ViewBag.ParticipantEmail ?? string.Empty);
    var passType     = (string)(ViewBag.ParticipantPass ?? "Standard");
    var ticketId     = (string)(ViewBag.TicketId ?? "TKT-000000");
    var qrSvg        = (string)(ViewBag.QrSvg ?? string.Empty);
    var now          = DateTime.Now;
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-10 col-lg-7">

        <!-- Message de succès -->
        <div class="alert alert-success alert-dismissible fade show animate-fadein mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-4 flex-shrink-0"></i>
                <div>
                    <strong>Paiement confirmé !</strong><br>
                    <small>Votre e-billet est prêt. Présentez le QR Code à l'entrée de l'événement.</small>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>

        <!-- Billet -->
        <div id="ticketCard" class="rounded-4 overflow-hidden shadow-lg mb-4"
             style="background:#fff;border:1px solid #E2E8F0;">

            <!-- En-tête billet -->
            <div class="p-4 text-white position-relative overflow-hidden"
                 style="background:linear-gradient(135deg,#111622 0%,#1A2236 60%,#2C1508 100%);">
                <div class="position-absolute opacity-10"
                     style="width:300px;height:300px;background:radial-gradient(circle,#FFB703,transparent);
                            top:-100px;right:-80px;pointer-events:none;"></div>
                <div class="position-relative d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small fw-bold mb-1" style="color:#FFB703;letter-spacing:0.08em;">
                            🎫 E-BILLET AfroEvent
                        </div>
                        <h4 class="fw-bold text-white mb-1">@eventName</h4>
                        <span class="badge px-3 py-1 rounded-pill fw-semibold"
                              style="background:rgba(255,183,3,0.2);color:#FFB703;border:1px solid rgba(255,183,3,0.3);">
                            Pass @passType
                        </span>
                    </div>
                    <div class="text-end">
                        <div class="small" style="color:rgba(255,255,255,0.5);">Statut</div>
                        <span class="badge bg-success px-3 py-2 rounded-pill fw-bold fs-6">
                            <i class="bi bi-check-circle-fill me-1"></i>Payé
                        </span>
                    </div>
                </div>
            </div>

            <!-- Séparateur en dents de scie (billet) -->
            <div class="d-flex align-items-center position-relative" style="height:24px;">
                <div style="background:#F1F5F9;height:1px;flex:1;"></div>
                <div class="position-absolute start-0"
                     style="width:24px;height:24px;background:#F8FAFC;border-radius:50%;border:1px solid #E2E8F0;margin-left:-12px;"></div>
                <div class="position-absolute end-0"
                     style="width:24px;height:24px;background:#F8FAFC;border-radius:50%;border:1px solid #E2E8F0;margin-right:-12px;"></div>
                <div style="flex:1;border-top:2px dashed #E2E8F0;margin:0 18px;"></div>
            </div>

            <!-- Corps du billet -->
            <div class="p-4">
                <div class="row align-items-center g-4">

                    <!-- Infos participant -->
                    <div class="col-12 col-md-7">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="small text-muted fw-semibold text-uppercase mb-1"
                                     style="letter-spacing:0.06em;">Participant</div>
                                <div class="fw-bold text-dark fs-5">@participantName</div>
                                @if (!string.IsNullOrEmpty(email))
                                {
                                    <div class="small text-muted">@email</div>
                                }
                            </div>
                            <div class="col-6">
                                <div class="small text-muted fw-semibold text-uppercase mb-1"
                                     style="letter-spacing:0.06em;font-size:0.65rem;">Type de pass</div>
                                <div class="fw-bold text-dark">@passType</div>
                            </div>
                            <div class="col-6">
                                <div class="small text-muted fw-semibold text-uppercase mb-1"
                                     style="letter-spacing:0.06em;font-size:0.65rem;">Date d'émission</div>
                                <div class="fw-bold text-dark" style="font-size:0.875rem;">
                                    @now.ToString("dd MMM yyyy · HH:mm")
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="small text-muted fw-semibold text-uppercase mb-1"
                                     style="letter-spacing:0.06em;font-size:0.65rem;">Numéro de billet</div>
                                <code class="fw-bold px-2 py-1 rounded-2"
                                      style="background:#F1F5F9;color:#F37021;font-size:0.85rem;letter-spacing:0.05em;">
                                    @ticketId
                                </code>
                            </div>
                        </div>
                    </div>

                    <!-- QR Code -->
                    <div class="col-12 col-md-5 text-center">
                        <div class="d-inline-block p-3 rounded-3 shadow-sm"
                             style="background:#fff;border:2px solid #F1F5F9;">
                            @if (!string.IsNullOrEmpty(qrSvg))
                            {
                                @Html.Raw(qrSvg)
                            }
                            else
                            {
                                <i class="bi bi-qr-code" style="font-size:5rem;color:#CBD5E1;"></i>
                            }
                        </div>
                        <p class="small text-muted mt-2 mb-0">
                            Scannez à l'entrée pour valider votre présence
                        </p>
                    </div>
                </div>
            </div>

            <!-- Footer billet -->
            <div class="px-4 py-3 d-flex align-items-center justify-content-between"
                 style="background:#F8FAFC;border-top:1px solid #E2E8F0;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-ticket-perforated-fill text-warning"></i>
                    <span class="fw-bold small" style="color:#111622;">AfroEvent</span>
                </div>
                <span class="small text-muted">Ce billet est nominatif et non remboursable.</span>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex flex-wrap gap-3 justify-content-center">
            <a asp-controller="Participant" asp-action="DownloadTicket" asp-route-nom="@eventName"
               class="btn btn-afro-gold fw-bold px-4 py-2 rounded-3">
                <i class="bi bi-download me-2"></i>Télécharger le billet
            </a>
            <a asp-controller="Events" asp-action="Index"
               class="btn btn-outline-secondary fw-semibold px-4 py-2 rounded-3">
                <i class="bi bi-calendar-event me-2"></i>Voir d'autres événements
            </a>
        </div>

        <!-- Info SignalR -->
        <div class="text-center mt-4">
            <small class="text-muted">
                <i class="bi bi-broadcast text-success me-1"></i>
                Votre inscription a été notifiée en temps réel à l'organisateur.
            </small>
        </div>
    </div>
</div>
