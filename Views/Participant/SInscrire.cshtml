@model AfroEvent.ViewModels.ParticipantInscriptionViewModel
@{
    ViewData["Title"] = "Inscription — " + (ViewBag.EventName ?? "Événement");
    var eventId   = (Guid)(ViewBag.EventId ?? Guid.Empty);
    var eventName = (string)(ViewBag.EventName ?? "Événement");
    var eventDate = ViewBag.EventDate is DateTime ed ? ed : (DateTime?)null;
    var eventLoc  = (string)(ViewBag.EventLocation ?? string.Empty);
    var eventPrice = ViewBag.EventPrice is decimal ep ? ep : 0m;
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-10">

        <!-- Récapitulatif de l'événement (breadcrumb contextuel) -->
        <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
            <a asp-controller="Events" asp-action="Index"
               class="text-muted small text-decoration-none">
                <i class="bi bi-calendar-event me-1"></i>Événements
            </a>
            <span class="text-muted small">/</span>
            <a asp-controller="Events" asp-action="Details" asp-route-id="@eventId"
               class="text-muted small text-decoration-none text-truncate" style="max-width:200px;">
                @eventName
            </a>
            <span class="text-muted small">/</span>
            <span class="small fw-semibold text-dark">Inscription</span>
        </div>

        <div class="row g-4">

            <!-- ── Formulaire ──────────────────────────────────── -->
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-md-5">

                        <h1 class="fw-bold mb-1" style="font-size:1.45rem;">
                            <i class="bi bi-ticket-detailed-fill text-warning me-2"></i>Votre inscription
                        </h1>
                        <p class="text-muted small mb-4">
                            Complétez les informations ci-dessous. Votre billet sera généré après paiement.
                        </p>

                        <form asp-controller="Participant" asp-action="SInscrire"
                              asp-route-eventId="@eventId" method="post" novalidate>
                            @Html.AntiForgeryToken()

                            <!-- Étape 1 : Informations personnelles -->
                            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                                <span class="d-flex align-items-center justify-content-center rounded-circle bg-warning text-dark fw-bold"
                                      style="width:24px;height:24px;font-size:0.72rem;flex-shrink:0;">1</span>
                                Informations personnelles
                            </h6>

                            <div class="row g-3 mb-4">
                                <div class="col-12 col-md-6">
                                    <label asp-for="NomComplet" class="form-label small fw-semibold text-muted">
                                        <i class="bi bi-person me-1"></i>Nom complet
                                    </label>
                                    <input asp-for="NomComplet" class="form-control rounded-3"
                                           placeholder="Ex : Amadou Traoré"
                                           autocomplete="name" />
                                    <span asp-validation-for="NomComplet" class="text-danger small"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label asp-for="Email" class="form-label small fw-semibold text-muted">
                                        <i class="bi bi-envelope me-1"></i>Adresse e-mail
                                    </label>
                                    <input asp-for="Email" class="form-control rounded-3"
                                           placeholder="vous@exemple.com"
                                           autocomplete="email" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Étape 2 : Type de pass -->
                            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                                <span class="d-flex align-items-center justify-content-center rounded-circle bg-warning text-dark fw-bold"
                                      style="width:24px;height:24px;font-size:0.72rem;flex-shrink:0;">2</span>
                                Type de pass
                            </h6>

                            <div class="row g-3 mb-3">
                                @foreach (var passType in Enum.GetValues(typeof(AfroEvent.ViewModels.TypePass)).Cast<AfroEvent.ViewModels.TypePass>())
                                {
                                    var passId = $"pass-{passType}";
                                    var (icon, desc) = passType switch
                                    {
                                        AfroEvent.ViewModels.TypePass.Etudiant      => ("bi-mortarboard-fill", "Tarif réduit pour les étudiants"),
                                        AfroEvent.ViewModels.TypePass.Professionnel => ("bi-briefcase-fill",   "Accès complet pour les professionnels"),
                                        AfroEvent.ViewModels.TypePass.VIP           => ("bi-star-fill",        "Accès prioritaire + espace lounge"),
                                        _                                            => ("bi-ticket-detailed",  "Pass standard")
                                    };
                                    <div class="col-12 col-md-4">
                                        <input class="d-none" type="radio"
                                               asp-for="TypeP" id="@passId" value="@passType" />
                                        <label for="@passId"
                                               class="d-flex flex-column align-items-center text-center p-3 rounded-4 border-2 w-100 h-100"
                                               style="cursor:pointer;border:2px solid #E2E8F0;transition:all 0.2s ease;">
                                            <i class="bi @icon text-warning mb-2" style="font-size:1.75rem;"></i>
                                            <span class="fw-bold small text-dark">@passType</span>
                                            <span class="text-muted mt-1" style="font-size:0.72rem;">@desc</span>
                                        </label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="TypeP" class="text-danger small d-block mb-3"></span>

                            <!-- Conditions -->
                            <div class="rounded-3 p-3 mb-4" style="background:#F8FAFC;border:1px solid #E2E8F0;">
                                <div class="form-check">
                                    <input asp-for="AccepteConditions" class="form-check-input" type="checkbox" id="condCheck" />
                                    <label class="form-check-label small text-muted" for="condCheck">
                                        J'accepte les
                                        <a href="/Home/Privacy" class="text-warning fw-semibold text-decoration-none">
                                            conditions générales
                                        </a>
                                        d'AfroEvent et m'engage à honorer mon inscription.
                                    </label>
                                </div>
                                <span asp-validation-for="AccepteConditions" class="text-danger small"></span>
                            </div>

                            <!-- Submit -->
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-afro-gold btn-lg rounded-3 fw-bold py-3">
                                    <i class="bi bi-arrow-right-circle-fill me-2"></i>Confirmer mon inscription
                                </button>
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@eventId"
                                   class="btn btn-outline-secondary rounded-3 fw-semibold">
                                    <i class="bi bi-arrow-left me-1"></i>Retour à l'événement
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- ── Récapitulatif Événement (sidebar) ───────────── -->
            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top:90px;">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="bi bi-receipt text-warning me-2"></i>Récapitulatif
                        </h6>

                        <div class="fw-bold text-dark mb-3" style="font-size:1rem;">@eventName</div>

                        <div class="d-flex flex-column gap-3 mb-4">
                            @if (eventDate.HasValue)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-2 d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:32px;height:32px;background:#FFF8E1;">
                                        <i class="bi bi-calendar-event text-warning"></i>
                                    </div>
                                    <div>
                                        <div class="small text-muted">Date</div>
                                        <div class="small fw-semibold text-dark">
                                            @eventDate.Value.ToString("dd MMMM yyyy · HH:mm")
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(eventLoc))
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-2 d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:32px;height:32px;background:#FFF1F1;">
                                        <i class="bi bi-geo-alt text-danger"></i>
                                    </div>
                                    <div>
                                        <div class="small text-muted">Lieu</div>
                                        <div class="small fw-semibold text-dark">@eventLoc</div>
                                    </div>
                                </div>
                            }
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-2 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:32px;height:32px;background:#F0FFF4;">
                                    <i class="bi bi-wallet2 text-success"></i>
                                </div>
                                <div>
                                    <div class="small text-muted">Prix du billet</div>
                                    <div class="fw-bold text-dark">
                                        @if (eventPrice > 0)
                                        {
                                            @eventPrice.ToString("N0") <span class="fw-normal text-muted small">FCFA</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">Gratuit</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <!-- Garanties -->
                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex align-items-center gap-2 small text-muted">
                                <i class="bi bi-shield-check text-success flex-shrink-0"></i>
                                Paiement 100% sécurisé
                            </div>
                            <div class="d-flex align-items-center gap-2 small text-muted">
                                <i class="bi bi-qr-code text-warning flex-shrink-0"></i>
                                E-billet QR Code instantané
                            </div>
                            <div class="d-flex align-items-center gap-2 small text-muted">
                                <i class="bi bi-envelope-check text-info flex-shrink-0"></i>
                                Confirmation par e-mail
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Styles {
<style>
    input[type="radio"]:checked + label {
        border-color: #FFB703 !important;
        background-color: rgba(255,183,3,0.06) !important;
        box-shadow: 0 0 0 3px rgba(255,183,3,0.15);
    }
    input[type="radio"] + label:hover {
        border-color: #FFB703 !important;
        background-color: rgba(255,183,3,0.03) !important;
    }
</style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
