@model AfroEvent.ViewModels.AdminDashboardViewModel

<div class="dash-card">
    <div class="dash-card-header">
        <div class="d-flex align-items-center gap-2">
            <div class="dash-stat-icon flex-shrink-0" style="background:rgba(255,183,3,0.12);width:36px;height:36px;">
                <i class="bi bi-people-fill text-warning"></i>
            </div>
            <div>
                <h6 class="mb-0">Gestion des Organisateurs</h6>
                <p class="text-muted mb-0" style="font-size:0.72rem;">
                    Validez les comptes organisateurs pour leur donner accès au tableau de bord.
                </p>
            </div>
        </div>
        @if (Model.OrganisateursEnAttenteCount > 0)
        {
            <span class="badge bg-danger rounded-pill px-3">
                @Model.OrganisateursEnAttenteCount en attente
            </span>
        }
    </div>

    <div class="card-body p-0">

        @if (Model.OrganisateursEnAttente != null && Model.OrganisateursEnAttente.Any())
        {
            <!-- Desktop Table -->
            <div class="table-responsive d-none d-md-block">
                <table class="table dash-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Organisateur</th>
                            <th>Organisation</th>
                            <th>Date de demande</th>
                            <th>Statut</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var org in Model.OrganisateursEnAttente)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="sidebar-user-avatar flex-shrink-0">
                                            @(org.NomComplet.Length > 0 ? org.NomComplet[0].ToString().ToUpper() : "O")
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark" style="font-size:0.875rem;">
                                                @org.NomComplet
                                            </div>
                                            <div class="text-muted" style="font-size:0.72rem;">@org.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-medium text-dark" style="font-size:0.875rem;">
                                        @(string.IsNullOrEmpty(org.NomOrganisation) ? "—" : org.NomOrganisation)
                                    </span>
                                </td>
                                <td>
                                    <span style="font-size:0.8rem;color:#64748B;">
                                        @org.DateDemande.ToString("dd MMM yyyy")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-category badge-realtime">
                                        <i class="bi bi-clock-fill me-1" style="font-size:0.55rem;"></i>
                                        @org.Statut
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <form asp-controller="Admin" asp-action="ApprouverOrganisateur" method="post"
                                              onsubmit="return confirm('Voulez-vous approuver cet organisateur ? Il recevra les droits pour créer et gérer des événements.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@org.Id" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-3 fw-semibold px-3"
                                                    title="Approuver l'organisateur">
                                                <i class="bi bi-check-lg me-1"></i>Approuver
                                            </button>
                                        </form>
                                        <form asp-controller="Admin" asp-action="RejeterOrganisateur" method="post"
                                              onsubmit="return confirm('Voulez-vous rejeter cet organisateur ? Cela supprimera définitivement son compte pour lui permettre de recréer une demande valide.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@org.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 fw-semibold px-3"
                                                    title="Rejeter la demande">
                                                <i class="bi bi-x-lg me-1"></i>Rejeter
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Cards -->
            <div class="d-md-none">
                @foreach (var org in Model.OrganisateursEnAttente)
                {
                    <div class="p-4 border-bottom">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="sidebar-user-avatar flex-shrink-0" style="width:44px;height:44px;font-size:1rem;">
                                @(org.NomComplet.Length > 0 ? org.NomComplet[0].ToString().ToUpper() : "O")
                            </div>
                            <div>
                                <div class="fw-bold text-dark" style="font-size:0.9rem;">@org.NomComplet</div>
                                <div class="text-muted small">@org.Email</div>
                                <div class="text-muted small">@(string.IsNullOrEmpty(org.NomOrganisation) ? "Sans organisation" : org.NomOrganisation)</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <form asp-controller="Admin" asp-action="ApprouverOrganisateur" method="post" class="flex-grow-1"
                                  onsubmit="return confirm('Voulez-vous approuver cet organisateur ? Il recevra les droits pour créer et gérer des événements.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@org.Id" />
                                <button type="submit" class="btn btn-success rounded-3 fw-semibold w-100">
                                    <i class="bi bi-check-lg me-1"></i>Approuver
                                </button>
                            </form>
                            <form asp-controller="Admin" asp-action="RejeterOrganisateur" method="post" class="flex-grow-1"
                                  onsubmit="return confirm('Voulez-vous rejeter cet organisateur ? Cela supprimera définitivement son compte pour lui permettre de recréer une demande valide.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@org.Id" />
                                <button type="submit" class="btn btn-outline-danger rounded-3 fw-semibold w-100">
                                    <i class="bi bi-x-lg me-1"></i>Rejeter
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 px-4">
                <i class="bi bi-person-check" style="font-size:4rem;color:#E2E8F0;"></i>
                <h6 class="text-muted fw-semibold mt-4 mb-2">Aucune demande en attente</h6>
                <p class="text-muted small mb-0">
                    Toutes les demandes d'organisateurs ont été traitées.<br>
                    Les nouvelles apparaîtront ici automatiquement.
                </p>
            </div>
        }
    </div>
</div>
