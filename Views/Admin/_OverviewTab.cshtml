@model AfroEvent.ViewModels.AdminDashboardViewModel

<!-- Stat Cards -->
<div class="row g-4 mb-4">

    <div class="col-6 col-xl-3">
        <div class="dash-stat">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="dash-stat-icon" style="background:rgba(255,183,3,0.12);">
                    <i class="bi bi-calendar-event-fill text-warning fs-5"></i>
                </div>
            </div>
            <div class="dash-stat-value">@Model.TotalEvenements.ToString("N0")</div>
            <div class="dash-stat-label mt-1">Événements</div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="dash-stat">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="dash-stat-icon" style="background:rgba(13,202,240,0.12);">
                    <i class="bi bi-people-fill text-info fs-5"></i>
                </div>
            </div>
            <div class="dash-stat-value">@Model.TotalOrganisateurs.ToString("N0")</div>
            <div class="dash-stat-label mt-1">Utilisateurs</div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="dash-stat">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="dash-stat-icon" style="background:rgba(45,198,83,0.12);">
                    <i class="bi bi-ticket-detailed-fill text-success fs-5"></i>
                </div>
            </div>
            <div class="dash-stat-value">@Model.TotalBilletsVendus.ToString("N0")</div>
            <div class="dash-stat-label mt-1">Billets émis</div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="dash-stat">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="dash-stat-icon" style="background:rgba(243,112,33,0.12);">
                    <i class="bi bi-wallet2 text-warning fs-5"></i>
                </div>
            </div>
            <div class="dash-stat-value" style="font-size:1.35rem;">
                @Model.TotalRevenusSimules.ToString("N0")
            </div>
            <div class="dash-stat-label mt-1">Revenus (FCFA)</div>
        </div>
    </div>

</div>

<div class="row g-4">

    <!-- Activités récentes -->
    <div class="col-12 col-xl-6">
        <div class="dash-card h-100">
            <div class="dash-card-header">
                <h6><i class="bi bi-activity text-warning me-2"></i>Activités récentes</h6>
            </div>
            <div class="card-body p-3">
                @if (Model.ActivitesRecentes != null && Model.ActivitesRecentes.Any())
                {
                    @foreach (var act in Model.ActivitesRecentes)
                    {
                        <div class="activity-item">
                            <div class="activity-dot" style="background: @(act.TypeBadgeClass.Contains("success") ? "#2DC653" : act.TypeBadgeClass.Contains("info") ? "#0DCAF0" : "#FFB703");"></div>
                            <div>
                                <div class="activity-text">@act.Description</div>
                                <div class="activity-time">@act.DateHeure.ToString("dd MMM yyyy · HH:mm")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-5 small">
                        <i class="bi bi-inbox fs-2 d-block mb-2 text-muted opacity-50"></i>
                        Aucune activité récente à afficher.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Organisateurs en attente -->
    <div class="col-12 col-xl-6">
        <div class="dash-card h-100">
            <div class="dash-card-header">
                <h6>
                    <i class="bi bi-person-check-fill text-warning me-2"></i>
                    Demandes d'organisateurs
                </h6>
                @if (Model.OrganisateursEnAttenteCount > 0)
                {
                    <span class="badge bg-danger rounded-pill">@Model.OrganisateursEnAttenteCount en attente</span>
                }
            </div>
            <div class="card-body p-3">
                @if (Model.OrganisateursEnAttente != null && Model.OrganisateursEnAttente.Any())
                {
                    @foreach (var org in Model.OrganisateursEnAttente.Take(5))
                    {
                        <div class="d-flex align-items-center gap-3 py-3 border-bottom">
                            <div class="sidebar-user-avatar flex-shrink-0" style="width:40px;height:40px;font-size:1rem;">
                                @(org.NomComplet.Length > 0 ? org.NomComplet[0].ToString().ToUpper() : "O")
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-semibold text-dark text-truncate small">@org.NomComplet</div>
                                <div class="text-muted" style="font-size:0.72rem;">@org.Email</div>
                            </div>
                            <div class="d-flex gap-1 flex-shrink-0">
                                <form asp-controller="Admin" asp-action="ApprouverOrganisateur" method="post"
                                      onsubmit="return confirm('Voulez-vous approuver cet organisateur ? Il recevra les droits pour créer et gérer des événements.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@org.Id" />
                                    <button type="submit" class="btn btn-sm btn-success rounded-3"
                                            title="Approuver">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                                <form asp-controller="Admin" asp-action="RejeterOrganisateur" method="post"
                                      onsubmit="return confirm('Voulez-vous rejeter cet organisateur ? Cela supprimera définitivement son compte pour lui permettre de recréer une demande valide.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@org.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3"
                                            title="Rejeter">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    @if (Model.OrganisateursEnAttenteCount > 5)
                    {
                        <div class="text-center pt-3">
                            <button class="nav-link w-100 small text-muted"
                                    onclick="document.getElementById('v-pills-organisateurs-tab').click()">
                                Voir tous les @Model.OrganisateursEnAttenteCount organisateurs →
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-5 small">
                        <i class="bi bi-person-check fs-2 d-block mb-2 opacity-50"></i>
                        Aucune demande en attente de validation.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
